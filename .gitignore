# Secretos y configuración local (el .exe crea .env y printers.yaml en su primera ejecución)
.env
printers.yaml

# Entornos y cachés de Python
.venv/
.venv-build/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Salida de compilación (se regenera con build-exe.ps1 / bridge\build.ps1)
bin/
obj/
bridge/zbin/
build/
dist/
app/_build_version.py
installer/deps/

# Datos que el .exe guarda junto a sí mismo
templates.json
carnets.json
settings.json
clients.json
png/
images/

# Software y documentación de terceros: se descarga, no se redistribuye
windows-drivers/
docs/*.pdf

# Firmas, fotos y vectores de personas: NUNCA van al repo (es público)
*.svg
firma*
foto-*
