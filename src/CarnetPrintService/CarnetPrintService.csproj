<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CarnetPrintService</AssemblyName>
    <RootNamespace>CarnetPrintService</RootNamespace>
    <!-- Permite compilar desde Linux/macOS aunque el binario sea para Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Impresión por el spooler de Windows: siempre disponible, sin SDK -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <!-- Alojar como servicio de Windows -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="escapes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
