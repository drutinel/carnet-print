<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ZebraBridge: puente de linea de comandos entre el middleware Python y el
    Link-OS Card SDK de Zebra (ZC100/ZC300). El SDK solo trae net471, por eso
    este proyecto es .NET Framework 4.8 (CardBridge de Entrust es net8).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Zebra.Printer.Card.SDK" Version="2.15.2634" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
