<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CardBridge: puente de linea de comandos entre el middleware Python y el
    SDK del driver XPS de Entrust (Sigma DS3). EntrustSdk/ son los fuentes
    "common" del XPS Card Printer SDK v8.8 (COM IBidiSpl), sin modificar.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);CA1416;SYSLIB0014;CS0168;CS0219;CS0162;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
