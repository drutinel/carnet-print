[Unit]
Description=Card Print Middleware
After=network.target cups.service
Wants=cups.service

[Service]
User=cardprint
WorkingDirectory=/opt/cardprint
EnvironmentFile=/opt/cardprint/.env
ExecStart=/opt/cardprint/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8080
Restart=on-failure

[Install]
WantedBy=multi-user.target
